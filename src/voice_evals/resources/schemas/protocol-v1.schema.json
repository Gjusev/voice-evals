{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voice-evals:protocol:1",
  "title": "voice-evals declarative protocol map",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "name", "audio", "outbound", "inbound", "capabilities"],
  "properties": {
    "protocol_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": {"$ref": "#/$defs/audio_decl"},
        "output": {"$ref": "#/$defs/audio_decl"}
      }
    },
    "handshake": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "send": {"type": "object"},
        "ready_event": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"type": "string", "minLength": 1}}
        }
      }
    },
    "outbound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audio"],
      "properties": {
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["media", "envelope"],
          "properties": {
            "media": {"enum": ["json_base64", "binary"]},
            "envelope": {"type": "object"}
          }
        },
        "end_utterance": {"type": "object"},
        "cancel": {"type": "object"}
      }
    },
    "inbound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discriminator", "events"],
      "properties": {
        "discriminator": {"type": "string", "minLength": 1},
        "events": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/event_mapping"}
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "env", "template"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "env": {"type": "string", "minLength": 1},
              "template": {"type": "string"}
            }
          }
        }
      }
    },
    "capabilities": {"$ref": "#/$defs/capabilities"}
  },
  "$defs": {
    "audio_decl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "sample_rate", "channels", "sample_width"],
      "properties": {
        "encoding": {"const": "pcm_s16le"},
        "sample_rate": {"enum": [16000, 24000]},
        "channels": {"const": 1},
        "sample_width": {"const": 2},
        "frame_ms": {"type": "integer", "minimum": 5, "maximum": 100},
        "delivery": {"enum": ["streaming", "burst"]}
      }
    },
    "pointer": {"type": "string", "pattern": "^(\\$\\.|/)"},
    "event_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "session_ready", "response_start", "response_done", "agent_audio",
            "agent_text_delta", "agent_text_final", "caller_transcript_delta",
            "caller_transcript_final", "outcome", "stage", "interrupted_ack", "error"
          ]
        },
        "direction": {"enum": ["agent", "caller", "system"]},
        "media": {"enum": ["json_base64", "binary"]},
        "selectors": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/pointer"},
          "propertyNames": {
            "enum": ["data", "text", "response_id", "utterance_id", "sequence", "value", "stage", "code", "message"]
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duplex", "incremental_output", "response_ids", "input_transcripts", "agent_transcripts", "response_end_events", "explicit_input_commit", "cancellation"],
      "properties": {
        "duplex": {"type": "boolean"},
        "incremental_output": {"type": "boolean"},
        "response_ids": {"type": "boolean"},
        "input_transcripts": {"type": "boolean"},
        "agent_transcripts": {"type": "boolean"},
        "response_end_events": {"type": "boolean"},
        "stage_events": {"type": "boolean"},
        "explicit_input_commit": {"type": "boolean"},
        "cancellation": {"type": "boolean"},
        "playback_ack": {"type": "boolean"},
        "outcome_events": {"type": "boolean"},
        "transcript_semantics": {"enum": ["delta", "snapshot"]}
      }
    }
  }
}
